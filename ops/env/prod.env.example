# Production : configuration separee, secrets injectes par la plateforme.
# AGENT_SECRET_KEY doit etre fourni par le coffre ; sinon le demarrage echoue (ET-008).
AGENT_ENVIRONMENT=prod
AGENT_ROLE=api
AGENT_DATABASE_URL=postgresql+psycopg://agent:CHANGEME@db-prod:5432/agent
AGENT_LOG_LEVEL=WARNING
AGENT_WORKSPACE_ID=11111111-1111-7111-8111-111111111111
AGENT_LEDGER_VERIFY_INTERVAL_SECONDS=900
# AGENT_SECRET_KEY=<injecte par le coffre>
