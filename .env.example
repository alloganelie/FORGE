# Copier vers .env et renseigner localement. Aucun secret reel dans le depot.
AGENT_ENVIRONMENT=local
AGENT_ROLE=api
AGENT_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:55432/agent
AGENT_LOG_LEVEL=INFO
AGENT_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
AGENT_LEDGER_VERIFY_INTERVAL_SECONDS=900
