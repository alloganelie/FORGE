{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.local/schemas/v1/source_registry.schema.json",
  "title": "Registre des sources v1",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "kind",
          "priority",
          "authorizations",
          "classification",
          "validity",
          "restrictions"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "authorizations": {
            "type": "object",
            "required": [
              "access",
              "use",
              "integration",
              "diffusion"
            ],
            "properties": {
              "access": {
                "type": "object",
                "required": [
                  "allowed"
                ],
                "properties": {
                  "allowed": {
                    "type": "boolean"
                  }
                }
              },
              "use": {
                "type": "object",
                "required": [
                  "allowed"
                ],
                "properties": {
                  "allowed": {
                    "type": "boolean"
                  }
                }
              },
              "integration": {
                "type": "object",
                "required": [
                  "allowed"
                ],
                "properties": {
                  "allowed": {
                    "type": "boolean"
                  }
                }
              },
              "diffusion": {
                "type": "object",
                "required": [
                  "allowed"
                ],
                "properties": {
                  "allowed": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "classification": {
            "type": "string"
          },
          "validity": {
            "type": "object"
          },
          "restrictions": {
            "type": "array"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
