{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.local/schemas/v1/control_catalog.schema.json",
  "title": "Catalogue de controles v1",
  "type": "object",
  "required": [
    "controls"
  ],
  "properties": {
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "definition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "mandatory_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
